{
  "manifest_version": 3,
  "name": "MagangHub AI Document & PDF Auto-Filler (9Router)",
  "version": "1.0.0",
  "description": "Ekstensi Chrome pintar auto-fill formulir MagangHub / SIAPkerja Kemnaker menggunakan file dokumen/PDF dan 9Router AI Gateway.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.kemnaker.go.id/*",
    "http://localhost:20128/*",
    "http://127.0.0.1:20128/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Buka MagangHub Auto-Filler Side Panel"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.kemnaker.go.id/*",
        "<all_urls>"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["content.css", "icons/*", "lib/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
